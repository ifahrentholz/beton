{
  "openapi": "3.1.0",
  "info": {
    "title": "beton",
    "description": "REST-API von beton. Fehler sind Problem-Objekte nach RFC 9457.",
    "contact": {
      "name": "Ingo Fahrentholz"
    },
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7420",
      "description": "Lokaler Daemon (Standard-Port)"
    }
  ],
  "paths": {
    "/auth/local/redeem": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Einmal-Code einlösen: setzt das Session-Cookie und leitet ohne Code weiter (AUTH-004).",
        "operationId": "redeem_login_code",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "next",
            "in": "query",
            "description": "Relativer Pfad für die Weiterleitung (Default `/`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Weiterleitung mit Set-Cookie"
          },
          "400": {
            "description": "Ungültige Anfrage",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin oder Berechtigung abgelehnt",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Interner Fehler (mit trace_id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Erreichbarkeit prüfen (ohne Anmeldung).",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Server läuft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrage",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin oder Berechtigung abgelehnt",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Interner Fehler (mit trace_id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/local/codes": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Einmal-Code erzeugen (AUTH-004). Nur mit lokalem Token und nur über Loopback.",
        "operationId": "create_login_code",
        "responses": {
          "201": {
            "description": "Einmal-Code erzeugt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginCode"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrage",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin oder Berechtigung abgelehnt",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Interner Fehler (mit trace_id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
