    "/v1/sessions": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Session-Liste, neueste zuerst, mit Cursor-Pagination.",
        "operationId": "list_sessions",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Anzahl der Einträge, 1 bis 200 (Default 50).",
            "required": false,
            "schema": {
              "type": "string",
              "maximum": 200,
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaker Cursor aus `next_cursor` der vorigen Seite.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_archived",
            "in": "query",
            "description": "Archivierte Sessions einschließen.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eine Seite der Session-Liste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionPage"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrage",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin oder Berechtigung abgelehnt",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Interner Fehler (mit trace_id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ws": {
      "get": {
        "tags": [
          "ws"
        ],
        "summary": "WebSocket-Verbindung (Upgrade, Subprotokoll `beton.v1`).",
        "operationId": "ws_upgrade",
        "responses": {
          "101": {
            "description": "Upgrade auf WebSocket, Subprotokoll beton.v1"
          },
          "400": {
            "description": "Ungültige Anfrage",
            "content": {
              "application/problem+json": {
                "schema": {
