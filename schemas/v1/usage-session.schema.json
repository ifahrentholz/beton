{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionUsageView",
  "description": "Antwort von `GET /v1/sessions/{id}/usage` und `beton usage --session <id> --json`.",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UsageRecordView"
      }
    },
    "session_id": {
      "type": "string"
    },
    "totals": {
      "$ref": "#/$defs/UsageTotals"
    }
  },
  "required": [
    "session_id",
    "records",
    "totals"
  ],
  "$defs": {
    "UsageItem": {
      "description": "Ein Eintrag: gruppierte Dimensionen (nur die angefragten) und Summen.",
      "type": "object",
      "properties": {
        "auth_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "billing": {
          "description": "`subscription` (Login der Vendor-CLI) oder `metered` (API-Key, Gateway, lokal).",
          "type": "string"
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost_usd": {
          "description": "Kosten in USD; `null` bei Subscription (kein Geldbetrag).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "day": {
          "description": "Kalendertag in der Zeitzone `tz` (`YYYY-MM-DD`).",
          "type": [
            "string",
            "null"
          ]
        },
        "equivalent_usd": {
          "description": "API-Äquivalent in USD, nur informativ; `null` außer bei Subscription.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "project_id": {
          "description": "Fehlt bei Sessions ohne Projekt.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "turns": {
          "description": "Turns (Usage-Records).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unpriced_count": {
          "description": "Turns ohne Preis („ohne Preis – Override anlegen“).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "billing",
        "turns",
        "sessions",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "unpriced_count"
      ]
    },
    "UsageRecordView": {
      "description": "Ein Turn einer Session (USE-007 AC2): Tokens, Kosten und Preisquelle.",
      "type": "object",
      "properties": {
        "auth_source": {
          "type": "string"
        },
        "billing": {
          "type": "string"
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost_source": {
          "description": "`override`, `harness`, `catalog`, `none` oder `subscription`.",
          "type": "string"
        },
        "cost_usd": {
          "description": "`null` bei Subscription und ohne Preis.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "equivalent_usd": {
          "description": "API-Äquivalent (informativ), nur bei Subscription.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "harness": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "pricing_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "description": "Zweck außerhalb der Unterhaltung, z. B. `title` oder `compaction`.",
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ts": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "ts",
        "harness",
        "model",
        "auth_source",
        "billing",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "cost_source"
      ]
    },
    "UsageTotals": {
      "description": "Summen je Abrechnungsart; es gibt bewusst keine Gesamtsumme.",
      "type": "object",
      "properties": {
        "metered": {
          "description": "API-Key, Gateway, lokal: mit Kosten.",
          "$ref": "#/$defs/UsageItem"
        },
        "subscription": {
          "description": "Login der Vendor-CLI: Tokens, kein Geld.",
          "$ref": "#/$defs/UsageItem"
        }
      },
      "required": [
        "metered",
        "subscription"
      ]
    }
  }
}
