{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beton-Konfiguration (config.yaml)",
  "description": "Die effektive Konfiguration.",
  "type": "object",
  "properties": {
    "auth": {
      "$ref": "#/$defs/AuthSettings",
      "default": {
        "ws_allowed_origins": []
      }
    },
    "events": {
      "$ref": "#/$defs/EventsSettings",
      "default": {
        "store_raw": true
      }
    },
    "features": {
      "description": "Eingeschaltete Feature-Flags, z. B. `[fake_harness]` (UX-007); zusätzlich\n`BETON_FEATURES=a,b`. Unbekannte Namen erzeugen nur eine Warnung.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "harnesses": {
      "description": "Harnesses: Binary, Argumente, Auth-Herkunft (HAR-003, HAR-015).",
      "$ref": "#/$defs/HarnessesConfig",
      "default": {}
    },
    "providers": {
      "description": "Provider des Direkt-API-Harness `direct:<name>` (HAR-011); nur in der\nUser-Konfiguration. Optional: Ohne Eintrag gibt es keinen Direkt-API-Harness\n(ADR-0034). Einträge werden beim Aufbau der Registry geprüft; ein ungültiger wird mit\nPfad und Grund gemeldet und übersprungen.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      },
      "default": {}
    },
    "server": {
      "$ref": "#/$defs/ServerSettings",
      "default": {
        "allowed_hosts": [],
        "listen": [
          "127.0.0.1:7420",
          "[::1]:7420"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AcpAgentConfig": {
      "description": "Ein ACP-Agent unter `harnesses.acp.agents.<slug>` (HAR-008).",
      "type": "object",
      "properties": {
        "args": {
          "description": "Argumente, mit denen der Agent ACP über stdio spricht, z. B. `[\"--experimental-acp\"]`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "Programm (Name in `PATH` oder Pfad).",
          "type": "string"
        },
        "env_passthrough": {
          "description": "Variablen, die trotz Bereinigung an den Agent gehen (z. B. `GEMINI_API_KEY`). Ohne\nAngabe erreicht keine `*_API_KEY`-Variable den Agent (ADR-0034).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp_bridge": {
          "description": "System-Tools per MCP an den Agent geben (HAR-009); wirkt mit der MCP-Bridge.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "models": {
          "description": "Modelle für den Modell-Picker (optional).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "AcpSection": {
      "description": "Abschnitt `harnesses.acp` (HAR-008).",
      "type": "object",
      "properties": {
        "agents": {
          "description": "ACP-Agents nach Slug (`[a-z0-9-]`), erreichbar als Harness `acp:<slug>`. Die Einträge\nwerden erst beim Aufbau der Registry geprüft: Ein ungültiger Eintrag wird mit Datei und\nZeile gemeldet und übersprungen, ohne andere Harnesses zu beeinträchtigen.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AcpAgentConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "AuthSettings": {
      "type": "object",
      "properties": {
        "ws_allowed_origins": {
          "description": "Zusätzlich erlaubte Origins für WebSocket und Cookie-Requests (AUTH-003).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "EventsSettings": {
      "type": "object",
      "properties": {
        "store_raw": {
          "description": "Original-Payloads der Harnesses speichern (PROTO-001 AC3).",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "HarnessAuth": {
      "description": "Auth-Herkunft in der Konfiguration (HAR-015): `subscription` = Login der offiziellen CLI.",
      "type": "string",
      "enum": [
        "subscription",
        "api_key"
      ]
    },
    "HarnessCommandConfig": {
      "description": "Ein Eintrag unter `harnesses.<id>` in `.beton/config.yaml` bzw. `~/.beton/config.yaml`.",
      "type": "object",
      "properties": {
        "auth": {
          "description": "Auth-Herkunft (HAR-015); ohne Angabe `subscription`. Nur in der User-Konfiguration.",
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessAuth"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "description": "Programm (Name in `PATH` oder Pfad), HAR-003.",
          "type": [
            "string",
            "null"
          ]
        },
        "env_passthrough": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isolated": {
          "description": "Benutzer-Anpassungen der Vendor-CLI (Hooks, Skills, Plugins, MCP) abschalten (HAR-004).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "mcp_bridge": {
          "description": "System-Tools (MCP-Server `beton`) an diesen Harness geben (HAR-009); Default `true`.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "HarnessesConfig": {
      "description": "Abschnitt `harnesses:` der Konfiguration.",
      "type": "object",
      "properties": {
        "acp": {
          "description": "Registrierte ACP-Agents (HAR-008).",
          "$ref": "#/$defs/AcpSection"
        },
        "default": {
          "description": "Standard-Harness für neue Sessions.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/HarnessCommandConfig"
      }
    },
    "ModelConfig": {
      "description": "Ein Modell unter `providers.<name>.models`.",
      "type": "object",
      "properties": {
        "context_window": {
          "description": "Kontextfenster in Tokens (für Kontextanzeige und Compaction).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pricing"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Pricing": {
      "description": "Preise eines Modells in USD je Million Tokens (Preis-Override, Owner USE-003).",
      "type": "object",
      "properties": {
        "input_per_mtok": {
          "type": "number",
          "format": "double"
        },
        "output_per_mtok": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "input_per_mtok",
        "output_per_mtok"
      ]
    },
    "ProviderConfig": {
      "description": "Ein Eintrag unter `providers.<name>` (Schema für `config.schema.json`).",
      "type": "object",
      "properties": {
        "api_key": {
          "description": "`none` für Endpunkte ohne Key (lokale Gateways); `secret://…` ab M2 (SEC-001).\nKlartext-Keys sind nicht erlaubt.",
          "type": [
            "string",
            "null"
          ]
        },
        "api_key_env": {
          "description": "M1: Name der Umgebungsvariable des Daemons mit dem Key, z. B. `OPENROUTER_API_KEY`.",
          "type": [
            "string",
            "null"
          ]
        },
        "base_url": {
          "description": "Basis-URL, z. B. `https://api.anthropic.com` oder `https://openrouter.ai/api/v1`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WireKind"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelConfig"
          }
        },
        "prompt_caching": {
          "description": "Anthropic: `cache_control` für System-Prompt und Tools setzen (Default `true`).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "base_url"
      ]
    },
    "ServerSettings": {
      "type": "object",
      "properties": {
        "allowed_hosts": {
          "description": "Zusätzlich erlaubte `Host`-Header (AUTH-002).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "listen": {
          "description": "TCP-Adressen; im lokalen Modus nur Loopback (AUTH-001).",
          "type": "array",
          "default": [
            "127.0.0.1:7420",
            "[::1]:7420"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "WireKind": {
      "description": "Wire-Familie eines Providers.",
      "oneOf": [
        {
          "description": "Anthropic Messages-API (`POST {base_url}/v1/messages`).",
          "type": "string",
          "const": "anthropic"
        },
        {
          "description": "OpenAI Chat Completions (`POST {base_url}/chat/completions`), auch OpenRouter,\nLiteLLM, vLLM, Ollama, LM Studio.",
          "type": "string",
          "const": "openai"
        }
      ]
    }
  }
}
