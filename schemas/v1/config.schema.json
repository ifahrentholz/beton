{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beton-Konfiguration (config.yaml)",
  "description": "Die effektive Konfiguration.",
  "type": "object",
  "properties": {
    "attachments": {
      "description": "Anhänge im Composer (WEB-006).",
      "$ref": "#/$defs/AttachmentSettings",
      "default": {
        "max_file_bytes": 20971520,
        "max_files": 10
      }
    },
    "auth": {
      "$ref": "#/$defs/AuthSettings",
      "default": {
        "ws_allowed_origins": []
      }
    },
    "compaction": {
      "description": "Automatische Compaction (USE-009): `auto: harness | beton | off`, `threshold` (0,8).",
      "$ref": "#/$defs/CompactionSettings",
      "default": {
        "auto": "harness",
        "threshold": 0.8
      }
    },
    "events": {
      "$ref": "#/$defs/EventsSettings",
      "default": {
        "store_raw": true
      }
    },
    "features": {
      "description": "Eingeschaltete Feature-Flags, z. B. `[fake_harness]` (UX-007); zusätzlich\n`BETON_FEATURES=a,b`. Unbekannte Namen erzeugen nur eine Warnung.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "harnesses": {
      "description": "Harnesses: Binary, Argumente, Auth-Herkunft (HAR-003, HAR-015).",
      "$ref": "#/$defs/HarnessesConfig",
      "default": {}
    },
    "observability": {
      "description": "Betreiber-Observability (OBS-003); nur in der User-Konfiguration.",
      "$ref": "#/$defs/ObservabilitySettings",
      "default": {
        "capture_content": false,
        "otlp": {
          "endpoint": null,
          "headers": {}
        }
      }
    },
    "pricing": {
      "description": "Eigene Preise (USE-003); nur in der User-Konfiguration.",
      "$ref": "#/$defs/PricingSettings",
      "default": {
        "overrides": []
      }
    },
    "providers": {
      "description": "Provider des Direkt-API-Harness `direct:<name>` (HAR-011); nur in der\nUser-Konfiguration. Optional: Ohne Eintrag gibt es keinen Direkt-API-Harness\n(ADR-0034). Einträge werden beim Aufbau der Registry geprüft; ein ungültiger wird mit\nPfad und Grund gemeldet und übersprungen.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      },
      "default": {}
    },
    "sandbox": {
      "description": "Sandbox (SBX-003); nur in der User-Konfiguration. Ein Projekt (also ein Repository)\ndarf sich keine Grants geben; Agent-Ebene und Policies folgen mit SBX-006/POL-024.",
      "$ref": "#/$defs/SandboxSpec",
      "default": {}
    },
    "secrets": {
      "description": "Secret-Store (SEC-002, SEC-003); nur in der User-Konfiguration.",
      "$ref": "#/$defs/SecretsSettings",
      "default": {
        "backend": "auto"
      }
    },
    "server": {
      "$ref": "#/$defs/ServerSettings",
      "default": {
        "allowed_hosts": [],
        "listen": [
          "127.0.0.1:7420",
          "[::1]:7420"
        ]
      }
    },
    "titles": {
      "description": "Automatische Session-Titel (SES-010).",
      "$ref": "#/$defs/TitlesSettings",
      "default": {
        "generator": "auto",
        "instructions": null,
        "provider": null
      }
    },
    "usage": {
      "description": "Usage-Anzeige und -Hinweise (USE-004).",
      "$ref": "#/$defs/UsageSettings",
      "default": {
        "rate_limit_notice": true
      }
    },
    "user": {
      "description": "Angaben zum User, z. B. `timezone` (POL-004 AC4); nur in der User-Konfiguration.",
      "$ref": "#/$defs/UserSettings",
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AcpAgentConfig": {
      "description": "Ein ACP-Agent unter `harnesses.acp.agents.<slug>` (HAR-008).",
      "type": "object",
      "properties": {
        "args": {
          "description": "Argumente, mit denen der Agent ACP über stdio spricht, z. B. `[\"--experimental-acp\"]`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "Programm (Name in `PATH` oder Pfad).",
          "type": "string"
        },
        "env_passthrough": {
          "description": "Variablen, die trotz Bereinigung an den Agent gehen (z. B. `GEMINI_API_KEY`). Ohne\nAngabe erreicht keine `*_API_KEY`-Variable den Agent (ADR-0034).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp_bridge": {
          "description": "System-Tools per MCP an den Agent geben (HAR-009); wirkt mit der MCP-Bridge.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "models": {
          "description": "Modelle für den Modell-Picker (optional).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "AcpSection": {
      "description": "Abschnitt `harnesses.acp` (HAR-008).",
      "type": "object",
      "properties": {
        "agents": {
          "description": "ACP-Agents nach Slug (`[a-z0-9-]`), erreichbar als Harness `acp:<slug>`. Die Einträge\nwerden erst beim Aufbau der Registry geprüft: Ein ungültiger Eintrag wird mit Datei und\nZeile gemeldet und übersprungen, ohne andere Harnesses zu beeinträchtigen.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AcpAgentConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "AttachmentSettings": {
      "type": "object",
      "properties": {
        "max_file_bytes": {
          "description": "Höchstgröße je Datei in Bytes (Default 20 MiB).",
          "type": "integer",
          "format": "uint64",
          "default": 20971520,
          "minimum": 0
        },
        "max_files": {
          "description": "Höchstzahl der Dateien je Nachricht (Default 10).",
          "type": "integer",
          "format": "uint32",
          "default": 10,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "AuthSettings": {
      "type": "object",
      "properties": {
        "ws_allowed_origins": {
          "description": "Zusätzlich erlaubte Origins für WebSocket und Cookie-Requests (AUTH-003).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "AutoCompaction": {
      "description": "Wer automatisch kompaktiert (`compaction.auto`, USE-009).",
      "oneOf": [
        {
          "description": "Der Harness entscheidet selbst (Vendor-CLIs; Direkt-API-Harness ab `threshold`).",
          "type": "string",
          "const": "harness"
        },
        {
          "description": "beton kompaktiert vor dem nächsten Turn, wenn der zuletzt gemeldete Kontext über\n`threshold` liegt – einmal je Überschreitung, bei Harnesses mit `compaction: native`.",
          "type": "string",
          "const": "beton"
        },
        {
          "description": "Nie automatisch, nur über den Button, `/compact` oder die API.",
          "type": "string",
          "const": "off"
        }
      ]
    },
    "BackendChoice": {
      "description": "Konfiguration `secrets.backend`.",
      "oneOf": [
        {
          "description": "OS-Keychain, sonst verschlüsselte Datei.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nur der OS-Keychain; ohne Keychain sind Secrets nicht verfügbar (fail closed).",
          "type": "string",
          "const": "keychain"
        },
        {
          "description": "Nur die verschlüsselte Datei `~/.beton/secrets/store.v1`.",
          "type": "string",
          "const": "file"
        }
      ]
    },
    "CompactionSettings": {
      "description": "`compaction:` in der User-Konfiguration (USE-009).",
      "type": "object",
      "properties": {
        "auto": {
          "description": "`harness` (Default), `beton` oder `off`.",
          "$ref": "#/$defs/AutoCompaction",
          "default": "harness"
        },
        "threshold": {
          "description": "Anteil des Kontextfensters (größer 0, höchstens 1), ab dem automatisch kompaktiert\nwird; Default 0,8.",
          "type": "number",
          "format": "double",
          "default": 0.8
        }
      },
      "additionalProperties": false
    },
    "EventsSettings": {
      "type": "object",
      "properties": {
        "store_raw": {
          "description": "Original-Payloads der Harnesses speichern (PROTO-001 AC3).",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "HarnessAuth": {
      "description": "Auth-Herkunft in der Konfiguration (HAR-015): `subscription` = Login der offiziellen CLI.",
      "type": "string",
      "enum": [
        "subscription",
        "api_key"
      ]
    },
    "HarnessCommandConfig": {
      "description": "Ein Eintrag unter `harnesses.<id>` in `.beton/config.yaml` bzw. `~/.beton/config.yaml`.",
      "type": "object",
      "properties": {
        "auth": {
          "description": "Auth-Herkunft (HAR-015); ohne Angabe `subscription`. Nur in der User-Konfiguration.",
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessAuth"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "description": "Programm (Name in `PATH` oder Pfad), HAR-003.",
          "type": [
            "string",
            "null"
          ]
        },
        "env_passthrough": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isolated": {
          "description": "Benutzer-Anpassungen der Vendor-CLI (Hooks, Skills, Plugins, MCP) abschalten (HAR-004).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "mcp_bridge": {
          "description": "System-Tools (MCP-Server `beton`) an diesen Harness geben (HAR-009); Default `true`.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "HarnessesConfig": {
      "description": "Abschnitt `harnesses:` der Konfiguration.",
      "type": "object",
      "properties": {
        "acp": {
          "description": "Registrierte ACP-Agents (HAR-008).",
          "$ref": "#/$defs/AcpSection"
        },
        "default": {
          "description": "Standard-Harness für neue Sessions.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/HarnessCommandConfig"
      }
    },
    "Limits": {
      "description": "`sandbox.limits` (SBX-013): Grenzen für den ganzen Prozessbaum einer Sandbox. Nicht gesetzte\nFelder begrenzen nichts.",
      "type": "object",
      "properties": {
        "cpu_seconds": {
          "description": "CPU-Zeit je Prozess in Sekunden (`RLIMIT_CPU`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "file_size_mb": {
          "description": "Größe einzelner Dateien in MiB (`RLIMIT_FSIZE`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "memory_mb": {
          "description": "Speicher des Baums in MiB (Linux: cgroup v2 `memory.max`, nur mit Delegation).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "pids": {
          "description": "Höchstzahl gleichzeitiger Prozesse und Threads (cgroup `pids.max` bzw. `RLIMIT_NPROC`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ModelConfig": {
      "description": "Ein Modell unter `providers.<name>.models`.",
      "type": "object",
      "properties": {
        "context_window": {
          "description": "Kontextfenster in Tokens (für Kontextanzeige und Compaction).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pricing"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ObservabilitySettings": {
      "description": "Traces je Session (OBS-003). Ohne Endpoint gibt es keinen Export (ADR-0025, ADR-0033).",
      "type": "object",
      "properties": {
        "capture_content": {
          "description": "Prompts und Tool-Argumente als Span-Attribute (geschwärzt); Default `false`.",
          "type": "boolean",
          "default": false
        },
        "otlp": {
          "$ref": "#/$defs/OtlpSettings",
          "default": {
            "endpoint": null,
            "headers": {}
          }
        }
      },
      "additionalProperties": false
    },
    "OtlpSettings": {
      "description": "OTLP-Export (OBS-003): OTLP/HTTP mit JSON-Kodierung.",
      "type": "object",
      "properties": {
        "endpoint": {
          "description": "Basis-URL des Collectors, z. B. `http://127.0.0.1:4318`; Traces gehen an\n`<endpoint>/v1/traces`. Ohne Angabe gilt `OTEL_EXPORTER_OTLP_TRACES_ENDPOINT` bzw.\n`OTEL_EXPORTER_OTLP_ENDPOINT`; fehlt auch das, wird nichts exportiert.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "headers": {
          "description": "Zusätzliche HTTP-Header, z. B. für die Anmeldung beim Collector.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "OverrideMatch": {
      "description": "Worauf ein Override passt: Glob (`*`, `?`) auf Provider und/oder Modell.",
      "type": "object",
      "properties": {
        "model": {
          "description": "Modell-ID, z. B. `llama-3.3-70b*`.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "description": "Provider, z. B. `litellm-intern` (Name unter `providers:`), `anthropic`, `openai`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "PriceOverride": {
      "description": "Eigener Preis für Gateway- und Self-hosted-Modelle (`pricing.overrides[]`).",
      "type": "object",
      "properties": {
        "cache_read_per_mtok": {
          "description": "Optional; sonst 0,1 × `input_per_mtok`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_write_per_mtok": {
          "description": "Optional; sonst 1,25 × `input_per_mtok`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "free": {
          "description": "Kostenlos, z. B. lokales Ollama; dann keine Preise angeben.",
          "type": "boolean"
        },
        "input_per_mtok": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "match": {
          "$ref": "#/$defs/OverrideMatch"
        },
        "output_per_mtok": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "match"
      ]
    },
    "Pricing": {
      "description": "Preise eines Modells in USD je Million Tokens (Preis-Override, Owner USE-003).",
      "type": "object",
      "properties": {
        "input_per_mtok": {
          "type": "number",
          "format": "double"
        },
        "output_per_mtok": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "input_per_mtok",
        "output_per_mtok"
      ]
    },
    "PricingSettings": {
      "description": "Eigene Preise für Gateway- und Self-hosted-Modelle (USE-003).",
      "type": "object",
      "properties": {
        "overrides": {
          "description": "Preis-Overrides mit Glob auf `provider`/`model`; der erste passende Eintrag gewinnt.\nGilt vor vom Harness gemeldeten Kosten und vor dem Preis-Katalog.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PriceOverride"
          }
        }
      },
      "additionalProperties": false
    },
    "ProviderConfig": {
      "description": "Ein Eintrag unter `providers.<name>` (Schema für `config.schema.json`).",
      "type": "object",
      "properties": {
        "api_key": {
          "description": "`none` für Endpunkte ohne Key (lokale Gateways); `secret://…` ab M2 (SEC-001).\nKlartext-Keys sind nicht erlaubt.",
          "type": [
            "string",
            "null"
          ]
        },
        "api_key_env": {
          "description": "M1: Name der Umgebungsvariable des Daemons mit dem Key, z. B. `OPENROUTER_API_KEY`.",
          "type": [
            "string",
            "null"
          ]
        },
        "base_url": {
          "description": "Basis-URL, z. B. `https://api.anthropic.com` oder `https://openrouter.ai/api/v1`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WireKind"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelConfig"
          }
        },
        "prompt_caching": {
          "description": "Anthropic: `cache_control` für System-Prompt und Tools setzen (Default `true`).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "base_url"
      ]
    },
    "SandboxBackend": {
      "description": "Isolations-Backend; `auto` wählt je Betriebssystem (SBX-001).",
      "type": "string",
      "enum": [
        "auto",
        "seatbelt",
        "landlock",
        "bwrap",
        "windows",
        "docker",
        "podman",
        "none"
      ]
    },
    "SandboxEnvConfig": {
      "description": "`sandbox.env`.",
      "type": "object",
      "properties": {
        "passthrough": {
          "description": "Namen oder Präfixe mit `*` (z. B. `LC_*`), die aus dem Daemon-Environment übernommen\nwerden.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "set": {
          "description": "Feste Werte.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "SandboxSpec": {
      "title": "Sandbox-Konfiguration (SBX-003)",
      "description": "Eine Ebene der Sandbox-Konfiguration (`sandbox:`). Nicht gesetzte Felder erbt sie von der\nweniger spezifischen Ebene.",
      "type": "object",
      "properties": {
        "allow_hidden": {
          "description": "Dotfiles direkt in Grants, die nicht maskiert werden (z. B. `.venv`).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "allow_network": {
          "description": "`false`: gar kein Netz; `true` (Default): nur über den Egress-Proxy.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "backend": {
          "description": "`auto` (Default), `seatbelt`, `landlock`, `bwrap`, `windows`, `docker`, `podman` oder\n`none` (keine Isolation, nur ausdrücklich).",
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxBackend"
            },
            {
              "type": "null"
            }
          ]
        },
        "egress_allow_private": {
          "description": "Ausdrücklich erlaubte private Ziele, z. B. `127.0.0.1:5432` (PRX-007).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "egress_rules": {
          "description": "Egress-Regeln des Proxys, z. B. `\"GET,HEAD registry.npmjs.org/**\"` (PRX-003).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "env": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxEnvConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "description": "Ressourcenlimits des Prozessbaums (SBX-013); je Feld gilt die spezifischste Ebene.",
          "anyOf": [
            {
              "$ref": "#/$defs/Limits"
            },
            {
              "type": "null"
            }
          ]
        },
        "masks": {
          "description": "Zusätzliche Masken: absolute Pfade (`~/…`, `/…`) oder Namensmuster mit `*`/`?` (ein\nPfadsegment, z. B. `.env.*` oder `secrets/`), die in jeder Wurzel in jeder Tiefe\ngelten. Ohne Angabe gilt im Workspace `[.env, .env.*]`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "read_paths": {
          "description": "Zusätzliche Lese-Wurzeln: absolut oder mit `~` (keine `$VAR`-Expansion).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "workspace": {
          "description": "`rw` (Default) oder `ro`.",
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceAccess"
            },
            {
              "type": "null"
            }
          ]
        },
        "write_paths": {
          "description": "Zusätzliche Schreib-Wurzeln (absolut oder mit `~`); `/`, `~` und dessen Vorfahren\nsind verboten.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "SecretsSettings": {
      "type": "object",
      "properties": {
        "backend": {
          "description": "`auto` (Default): OS-Keychain, sonst verschlüsselte Datei `~/.beton/secrets/store.v1`;\n`keychain` oder `file` erzwingen ein Backend. Die Passphrase der Datei kommt von\n`beton secrets unlock` oder aus `BETON_SECRETS_PASSPHRASE_FILE`.",
          "$ref": "#/$defs/BackendChoice",
          "default": "auto"
        }
      },
      "additionalProperties": false
    },
    "ServerSettings": {
      "type": "object",
      "properties": {
        "allowed_hosts": {
          "description": "Zusätzlich erlaubte `Host`-Header (AUTH-002).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "listen": {
          "description": "TCP-Adressen; im lokalen Modus nur Loopback (AUTH-001).",
          "type": "array",
          "default": [
            "127.0.0.1:7420",
            "[::1]:7420"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TitleGeneratorSetting": {
      "description": "Wie Session-Titel entstehen (SES-010).",
      "oneOf": [
        {
          "description": "Einmal-Aufruf über den Harness der Session (Subscription der CLI), sonst Heuristik.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Direkt-API-Harness mit `titles.provider`; nur ausdrücklich (ADR-0034).",
          "type": "string",
          "const": "direct"
        },
        {
          "description": "Wie `auto`, ohne Heuristik.",
          "type": "string",
          "const": "harness"
        },
        {
          "description": "Nur Heuristik (erste Zeile der ersten Nachricht), kein Modellaufruf.",
          "type": "string",
          "const": "off"
        }
      ]
    },
    "TitlesSettings": {
      "type": "object",
      "properties": {
        "generator": {
          "description": "`auto` (Default), `harness`, `direct` oder `off`. „Titel automatisch erzeugen“ aus\nentspricht `off`.",
          "$ref": "#/$defs/TitleGeneratorSetting",
          "default": "auto"
        },
        "instructions": {
          "description": "Zusätzliche Anweisung an das Modell (höchstens 2 000 Zeichen).",
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "maxLength": 2000
        },
        "provider": {
          "description": "Kleinmodell des Direkt-API-Harness, nur mit `generator: direct`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "UsageSettings": {
      "description": "Usage (USE-004): Hinweise zu Abo-Fenstern der Vendor-Logins.",
      "type": "object",
      "properties": {
        "rate_limit_notice": {
          "description": "Inbox-Hinweis, sobald ein Abo-Fenster (z. B. 5h) zu mindestens 90 % genutzt ist; einmal\nje Fenster und Periode. Default `true`.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "UserSettings": {
      "description": "Angaben zum User (POL-004 AC4).",
      "type": "object",
      "properties": {
        "timezone": {
          "description": "Zeitzone des Users als IANA-Name (z. B. `Europe/Berlin`, mit Sommerzeit), `UTC` oder\nfester Versatz (`+02:00`). Bestimmt Tages- und Monatsgrenzen von\n`user.daily_cost_usd`/`user.monthly_cost_usd`, den Tag von `user_day` (POL-009) und\nden Default von `tz` in `GET /v1/usage`; `beton usage` rechnet damit statt mit dem\nlokalen Versatz. Ohne Angabe gilt UTC. Ein unbekannter Name ist ein\nKonfigurationsfehler.",
          "anyOf": [
            {
              "$ref": "#/$defs/UserTimeZone"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "UserTimeZone": {
      "description": "IANA-Zeitzone (z. B. `Europe/Berlin`), `UTC` oder fester Versatz (`+02:00`).",
      "type": "string",
      "examples": [
        "Europe/Berlin",
        "UTC"
      ]
    },
    "WireKind": {
      "description": "Wire-Familie eines Providers.",
