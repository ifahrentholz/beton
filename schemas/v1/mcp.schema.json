{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beton MCP-Server (mcp.yaml)",
  "description": "Inhalt von `~/.beton/mcp.yaml` bzw. `.beton/mcp.yaml`.",
  "type": "object",
  "properties": {
    "servers": {
      "description": "MCP-Server nach Name (`[a-z0-9_-]`, höchstens 64 Zeichen; `beton` ist reserviert).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/McpServer"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "McpServer": {
      "description": "MCP-Server: stdio (`command`, `args`, `env`) oder HTTP (`url`, `headers`).",
      "type": "object",
      "properties": {
        "allow": {
          "description": "Nur diese Tools des Servers sind sichtbar.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
